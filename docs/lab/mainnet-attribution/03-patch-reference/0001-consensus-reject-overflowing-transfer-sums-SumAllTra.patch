+ResVal<CBalances> CCustomTxVisitor::SumTransfers(const CAccounts &accounts) const {
+    const auto &consensus = txCtx.GetConsensus();
+    const auto height = txCtx.GetHeight();
+    if (height >= static_cast<uint32_t>(consensus.DF25Height)) {
+        return SumAllTransfersChecked(accounts);
+    }
+    // Pre-fork behaviour kept for historical block validation
+    return {SumAllTransfers(accounts), Res::Ok()};
+}
