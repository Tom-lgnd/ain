diff --git a/src/test/balances_tests.cpp b/src/test/balances_tests.cpp
new file mode 100644
index 0000000..e0bd189
--- /dev/null
+++ b/src/test/balances_tests.cpp
@@ -0,0 +1,84 @@
+// Copyright (c) DeFi Blockchain Developers
+// Distributed under the MIT software license, see the accompanying
+// file LICENSE or http://www.opensource.org/licenses/mit-license.php.
+
+#include <dfi/balances.h>
+#include <test/setup_common.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <limits>
+
+BOOST_FIXTURE_TEST_SUITE(balances_tests, BasicTestingSetup)
+
+static CScript Owner(uint8_t n) {
+    return CScript() << OP_DUP << OP_HASH160 << std::vector<uint8_t>(20, n) << OP_EQUALVERIFY << OP_CHECKSIG;
+}
+
+static CBalances Bal(DCT_ID id, CAmount amount) {
+    CBalances b;
+    b.balances[id] = amount;
+    return b;
+}
+
+BOOST_AUTO_TEST_CASE(sum_all_transfers_normal)
+{
+    CAccounts to;
+    to[Owner(1)] = Bal(DCT_ID{0}, 5 * COIN);
+    to[Owner(2)] = Bal(DCT_ID{0}, 7 * COIN);
+    to[Owner(3)] = Bal(DCT_ID{2}, 1 * COIN);
+
+    const auto legacy = SumAllTransfers(to);
+    const auto checked = SumAllTransfersChecked(to);
+    BOOST_REQUIRE(checked);
+    BOOST_CHECK(legacy == *checked);
+    BOOST_CHECK_EQUAL(checked->balances.at(DCT_ID{0}), 12 * COIN);
+    BOOST_CHECK_EQUAL(checked->balances.at(DCT_ID{2}), 1 * COIN);
+}
+
+// Exploit of 03.11.2026 (block 6564035): 1 sat + INT64_MAX to two recipients.
+BOOST_AUTO_TEST_CASE(sum_all_transfers_overflow)
+{
+    const auto maxAmount = std::numeric_limits<CAmount>::max();
+
+    CAccounts to;
+    to[Owner(1)] = Bal(DCT_ID{0}, 1);
+    to[Owner(2)] = Bal(DCT_ID{0}, maxAmount);
+    BOOST_REQUIRE(Owner(1) < Owner(2)); // 1 sat is summed first, as on mainnet
+
+    // Legacy behaviour (documents the bug): the overflowing addition is dropped
+    const auto legacy = SumAllTransfers(to);
+    BOOST_CHECK_EQUAL(legacy.balances.at(DCT_ID{0}), 1);
+
+    // Fixed behaviour: error instead of a truncated sum
+    const auto checked = SumAllTransfersChecked(to);
+    BOOST_CHECK(!checked);
+}
+
+// Overflow on one token must not silently hide other tokens of the same recipient
+BOOST_AUTO_TEST_CASE(sum_all_transfers_overflow_multi_token)
+{
+    const auto maxAmount = std::numeric_limits<CAmount>::max();
+
+    CAccounts to;
+    to[Owner(1)] = Bal(DCT_ID{0}, 1);
+    CBalances second;
+    second.balances[DCT_ID{0}] = maxAmount;
+    second.balances[DCT_ID{2}] = 100 * COIN;
+    to[Owner(2)] = second;
+
+    const auto legacy = SumAllTransfers(to);
+    BOOST_CHECK(legacy.balances.find(DCT_ID{2}) == legacy.balances.end()); // token 2 vanished from the sum
+
+    BOOST_CHECK(!SumAllTransfersChecked(to));
+}
+
+BOOST_AUTO_TEST_CASE(sum_all_transfers_non_positive)
+{
+    CAccounts to;
+    to[Owner(1)] = Bal(DCT_ID{0}, 5 * COIN);
+    to[Owner(2)] = Bal(DCT_ID{0}, -1);
+    BOOST_CHECK(!SumAllTransfersChecked(to));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
