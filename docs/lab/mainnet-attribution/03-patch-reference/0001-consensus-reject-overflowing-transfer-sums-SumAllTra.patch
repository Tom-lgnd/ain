+// LEGACY: silently drops any addition that fails (negative amount or int64
+// overflow), so the returned sum can be far smaller than the sum of the
+// individual transfers. Consensus code must keep using it below DF25Height to
+// stay compatible with historical blocks, but MUST use SumAllTransfersChecked
+// from DF25Height on (see CCustomTxVisitor::SumTransfers).
 inline CBalances SumAllTransfers(const CAccounts &to) {
     CBalances sum;
     for (const auto &kv : to) {
@@ -270,6 +275,24 @@ inline CBalances SumAllTransfers(const CAccounts &to) {
     return sum;
 }
 
+// Checked variant: every single amount has to be positive and the per-token
+// sum must not overflow CAmount. Otherwise an error is returned instead of a
+// truncated sum.
+inline ResVal<CBalances> SumAllTransfersChecked(const CAccounts &to) {
+    CBalances sum;
+    for (const auto &[owner, balances] : to) {
+        for (const auto &[tokenId, amount] : balances.balances) {
+            if (amount <= 0) {
+                return Res::Err("transfer amount must be positive (%s@%d)", GetDecimalString(amount), tokenId.v);
+            }
+        }
+        if (auto res = sum.AddBalances(balances.balances); !res) {
+            return Res::Err("sum of transfers overflows: %s", res.msg);
+        }
+    }
+    return {sum, Res::Ok()};
+}
+
 struct BalanceKey {
     CScript owner;
     DCT_ID tokenID;
